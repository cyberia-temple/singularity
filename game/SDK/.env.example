# Cyberia Network defaults to the public RPC when this variable is omitted.
CYBERIA_RPC_URL=https://rpc.cyberia.church

# Required only for transactions and deployments. Never commit a funded key.
CYBERIA_PRIVATE_KEY=

# Fixed recipient of inactivity penalties in the new asynchronous contract.
ARENA_TREASURY_ADDRESS=
# Manifest recovery: 2 = asynchronous rules; 1 = original deployed MVP.
ARENA_RULES_VERSION=2
