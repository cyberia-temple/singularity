{
  "name": "cyberia-game-sdk",
  "private": true,
  "version": "0.1.0",
  "description": "Reusable tooling and contracts for games on Cyberia Network",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "hardhat build && tsc --noEmit",
    "test": "hardhat test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "clean": "hardhat clean",
    "verify:deployment": "hardhat run scripts/verify.ts --network cyberia --build-profile production",
    "deploy:cyberia": "hardhat run scripts/deploy.ts --network cyberia --build-profile production"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.0.0",
    "chai": "^6.2.2",
    "eslint": "^10.8.0",
    "hardhat": "^3.15.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0"
  }
}
