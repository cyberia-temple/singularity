require 'base64'

# Store uploads for the Cyberia mobile app.
#
# These lanes are what .github/workflows/stores.yml runs; they can also run
# from a workstation with the same environment variables. Each one uploads to
# the stage a person still has to promote — Play's internal track, TestFlight —
# because a store release is the one step here that cannot be taken back.
#
# Both stores must be built with CYBERIA_STORE set (play / appstore): that is
# what makes the site serve the store edition of the wallet
# (resources/js/lib/storeEdition.ts). `npm run sync:play` / `sync:appstore`
# set it.

default_platform(:android)

platform :android do
  desc 'Upload the signed AAB, listing text and graphics to Google Play'
  lane :play do
    upload_to_play_store(
      package_name: 'cyberia.app',
      json_key_data: ENV.fetch('PLAY_SERVICE_ACCOUNT_JSON'),
      aab: ENV.fetch('PLAY_AAB', 'android/app/build/outputs/bundle/release/app-release.aab'),
      track: ENV.fetch('PLAY_TRACK', 'internal'),
      # A Play app that has never been reviewed only accepts draft releases;
      # set PLAY_RELEASE_STATUS=completed once the first one is through.
      release_status: ENV.fetch('PLAY_RELEASE_STATUS', 'draft'),
      metadata_path: 'fastlane/metadata/android',
      skip_upload_metadata: ENV['PLAY_SKIP_METADATA'] == '1',
      skip_upload_images: ENV['PLAY_SKIP_METADATA'] == '1',
      skip_upload_screenshots: ENV['PLAY_SKIP_METADATA'] == '1',
      skip_upload_changelogs: false,
    )
  end
end

platform :ios do
  # One App Store Connect API key does three jobs: Xcode's cloud-managed
  # signing (no certificate or profile is stored anywhere), the TestFlight
  # upload and the listing. It needs the Admin role for the first.
  private_lane :asc_key do
    app_store_connect_api_key(
      key_id: ENV.fetch('ASC_KEY_ID'),
      issuer_id: ENV.fetch('ASC_ISSUER_ID'),
      key_content: ENV.fetch('ASC_KEY_P8_BASE64'),
      is_key_content_base64: true,
      in_house: false,
    )
  end

  desc 'Build, sign with cloud-managed certificates and upload to TestFlight'
  lane :testflight_upload do
    key = asc_key
    key_path = File.expand_path('../asc-key.p8', __dir__)
    File.write(key_path, Base64.decode64(ENV.fetch('ASC_KEY_P8_BASE64')))

    begin
      build_app(
        project: 'ios/App/App.xcodeproj',
        scheme: 'App',
        configuration: 'Release',
        export_method: 'app-store',
        output_directory: 'build/ios',
        output_name: 'Cyberia.ipa',
        clean: true,
        xcargs: [
          "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}",
          'CODE_SIGN_STYLE=Automatic',
          "MARKETING_VERSION=#{ENV.fetch('CYBERIA_VERSION_NAME', '1.0.0')}",
          "CURRENT_PROJECT_VERSION=#{ENV.fetch('CYBERIA_BUILD_NUMBER', '1')}",
          '-allowProvisioningUpdates',
          "-authenticationKeyPath #{key_path}",
          "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
          "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
        ].join(' '),
        export_xcargs: [
          '-allowProvisioningUpdates',
          "-authenticationKeyPath #{key_path}",
          "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
          "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
        ].join(' '),
      )
    ensure
      File.delete(key_path) if File.exist?(key_path)
    end

    upload_to_testflight(
      api_key: key,
      ipa: 'build/ios/Cyberia.ipa',
      skip_waiting_for_build_processing: true,
    )
  end

  desc 'Push the App Store listing (text, screenshots, review notes); submits nothing'
  lane :listing do
    upload_to_app_store(
      api_key: asc_key,
      skip_binary_upload: true,
      skip_screenshots: !Dir.exist?(File.expand_path('screenshots/ios/en-US', __dir__)),
      metadata_path: 'fastlane/metadata/ios',
      screenshots_path: 'fastlane/screenshots/ios',
      submit_for_review: false,
      force: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
    )
  end
end
