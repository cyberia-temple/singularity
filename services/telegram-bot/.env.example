# Cyberia Telegram airdrop bot — environment.
# Copy to .env and fill in. Never commit the real .env (see .gitignore).
# Override the file location with BOT_ENV_FILE if you keep it elsewhere.

# --- Required to run the bot ---
TELEGRAM_BOT_TOKEN=
# Deployer key used for on-chain mints (chat tokens, reward payouts, claims).
# NEVER commit or log this value.
DEPLOYER_PK=

# --- Optional ---
TELEGRAM_CHAT_ID=
# http:// or socks5:// proxy for the Telegram API (blank = direct).
HTTP_PROXY=
# Shared Laravel SQLite DB. On prod this points at the live database.sqlite.
DB_PATH=
# Factory used by /create_token (per-chat reward tokens).
TELEGRAM_TOKEN_FACTORY=

# --- AI assistant (OpenAI-compatible chat completions API) ---
# Leave AI_API_KEY empty to disable. The assistant answers normal text in DMs;
# in groups it answers /ask, @bot mentions, and replies to the bot.
AI_API_KEY=
# OPENAI_API_KEY is also accepted when AI_API_KEY is unset.
# If both are empty, the monorepo deployment automatically reuses
# ../lainos/.env's OPENROUTER_API_KEY and OPENROUTER_MODEL_SMALL.
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-4.1-mini
# AI_TIMEOUT_SECONDS=45
# AI_MAX_OUTPUT_TOKENS=700
# Number of prior user/assistant messages retained per user and chat.
# AI_HISTORY_MESSAGES=8
# Per-user spam/cost controls.
# AI_USER_COOLDOWN_SECONDS=3
# AI_MAX_CONCURRENT_REQUESTS=3
# AI_MAX_QUESTION_CHARS=4000
# Which model answers is the user's own choice: /model lists the provider's
# free models (read from {base}/models, so the list is never stale) and pins
# one per user. AI_MODEL is what an unset user gets — on OpenRouter that is
# `openrouter/free`, a router over the whole free pool rather than one model.
# AI_MODEL_CHOICE=1
# AI_MODELS_CACHE_SECONDS=1800
# AI_MODELS_PAGE_SIZE=8
# Override only when the catalogue does not sit next to AI_API_URL.
# AI_MODELS_URL=
# Send the AI traffic (catalogue and answers) through a proxy where the
# provider is blocked. Unset means direct.
# AI_PROXY_URL=

# --- Chain (defaults are Cyberia mainnet; override only to point elsewhere) ---
# RPC_URL=https://rpc.cyberia.church
# CHAIN_ID=49406
# EXPLORER_URL=https://explorer.cyberia.church

# --- Announcers (all default to @cyberia_network_chat) ---
# BRIDGE_ANNOUNCE_CHAT=@cyberia_network_chat
# Lending supply/withdraw/borrow/repay announcer. Same address the DEX frontend
# reads as VITE_LENDING_COMPTROLLER. Leave empty to disable the lending announcer.
LENDING_COMPTROLLER=
# CyberSolSwap redeemer that converts bridged CYBER.sol -> native CYBER (1000:1).
# Defaults to the live deployment; set empty to disable the conversion announcer.
# CYBERSOL_SWAP_ADDRESS=0x69b1614B088F5670E49bcC6fE33F28F2544F7415
# MasterChef whose solo (single-asset) pools feed the /staking stake/unstake
# announcer; LP-farm pids are skipped. Defaults to the live ASH MasterChef;
# set empty to disable.
# STAKING_MASTERCHEF=0xd540DEa828567160FFDe5e792ca359aDD1f6B03D
# STAKING_ANNOUNCE_CHAT=@cyberia_network_chat
# DIGEST_INTERVAL_SECONDS=21600

# --- pump.fun buy bot ---
# Posts every CYBER.sol buy worth at least PUMPFUN_MIN_BUY_USD. Set
# PUMPFUN_ANNOUNCE_CHAT empty to turn the buy bot off.
# PUMPFUN_ANNOUNCE_CHAT=@cyberia_network_chat
# PUMPFUN_MIN_BUY_USD=5
# PUMPFUN_POLL_SECONDS=30
# Pin the pool to watch. Left blank, the deepest SOL-quoted CYBER.sol pair from
# the market feed is used, so a migration needs no redeploy.
# PUMPFUN_POOL_ADDRESS=
# A returning buyer's post says how much their bag grew. Below this percentage
# the line is left out instead of rounding down to "0% Up!".
# PUMPFUN_MIN_POSITION_PCT=1
# Footer links under each buy. Blank turns one off.
# PUMPFUN_CHART_URL=https://dexscreener.com/solana/E67WWiQY4s9SZbCyFVTh2CEjorEYbhuVJQUZb3Mbpump
# PUMPFUN_TRADE_URL=https://pump.fun/coin/E67WWiQY4s9SZbCyFVTh2CEjorEYbhuVJQUZb3Mbpump
# A buy older than this is recorded for the digest but not posted, so a watcher
# coming back from an outage does not announce yesterday's trades as news.
# PUMPFUN_MAX_AGE_SECONDS=1800
# A busy public Solana RPC will rate-limit the buy bot; point SOLANA_RPC_URL at
# a dedicated endpoint if posts start arriving late.
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Every Solana read (buy bot + whales gate) walks these in order until one
# answers: SOLANA_RPC_URL, then this comma-separated list, then the keyless
# public cluster, which is always tried last. That is what makes a key that
# expires or runs out of credits latency instead of an outage — it happened on
# 2026-08-14 and both surfaces went silent for a day. Same variable name as
# Laravel's relay (config/solana.php), so one .env line can serve both.
# SOLANA_RPC_FALLBACK_URL=
# How long an endpoint that refused is left alone before it is tried again.
# SOLANA_RPC_COOLDOWN_SECONDS=300
# SOLANA_RPC_TIMEOUT=15
# Hide tiny price wiggles below this threshold. 100 = 1%.
# DIGEST_PRICE_CHANGE_MIN_BPS=100
# DIGEST_PRICE_TOKEN_LIMIT=8

# --- Whales chat gate ---
# Numeric chat id of the whales supergroup (looks like -1002688848155, NOT
# 2688848155). The bot must be an admin there with "Invite Users via Link".
# Leave empty to disable the whale gate entirely.
WHALE_CHAT_ID=

# --- NFT from channel posts ---
# When the bot is an admin of a PUBLIC channel, each new post is minted into the
# shared CyberiaNFT collection (ERC-721 + IPFS metadata) and shows on the NFT
# marketplace. Needs DEPLOYER_PK (signs the mint) and a reachable Kubo node.
# Set NFT_FROM_POSTS=0 to disable.
NFT_FROM_POSTS=1
# Pin metadata to IPFS but skip the on-chain mint (no gas) — for testing.
NFT_FROM_POSTS_DRYRUN=0
# CyberiaNFT collection (default is the live deployment).
# CYBERIA_NFT_ADDRESS=0x546462FAbf30734E63b64f32B30EC8ADD9B6EBa7
# Local Kubo HTTP API for pinning images + metadata.
IPFS_API_URL=http://127.0.0.1:5001

# --- Wallet Mini App ---
# The wallet opened inside Telegram. It is the site's own /wallet page, so a
# deploy updates it; nothing is bundled or hosted by the bot. HTTPS only.
# WALLET_MINI_APP_URL=https://cyberia.church/wallet
# Put it behind the ☰ menu button next to the input box. 0 keeps the plain
# command menu there instead.
WALLET_MINI_APP_MENU=1

# --- Logging (optional) ---
# Default log file is services/telegram-bot/bot.log; override here if ops watch
# a different path (logs always also go to stdout).
# BOT_LOG_FILE=
