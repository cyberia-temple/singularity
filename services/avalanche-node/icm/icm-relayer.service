[Unit]
Description=ICM relayer — Teleporter messages between the C-Chain and Cyberia
After=avalanchego.service network-online.target
Wants=network-online.target

[Service]
User=icm
Group=icm
EnvironmentFile=/etc/icm/relayer.env
ExecStart=/opt/icm/icm-relayer/icm-relayer --config-file=/etc/icm/icm-relayer.json
StateDirectory=icm-relayer
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
