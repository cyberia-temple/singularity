[Unit]
Description=AvalancheGo — Cyberia L1 validator
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
User=avalanche
Group=avalanche
ExecStart=/opt/avalanchego/current/avalanchego --config-file=/etc/avalanchego/node.json
Restart=always
RestartSec=5
LimitNOFILE=65536
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/avalanchego

[Install]
WantedBy=multi-user.target
