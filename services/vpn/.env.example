# CyberiaVpnPass on the Cyberia chain (deployments/cyberia-vpn-pass-49406.json).
VPN_RPC_URL=https://rpc.cyberia.church
VPN_CHAIN_ID=49406
VPN_PASS_ADDRESS=
VPN_PASS_FROM_BLOCK=0

# This node, as clients reach it. VPN_PUBLIC_HOST must resolve to this host.
VPN_PUBLIC_HOST=
VPN_NODE_ID=
VPN_PORT=443
VPN_GATE_PORT=8780

# Reality camouflage: a real TLS 1.3 site the handshake borrows. Pick one that
# is reachable from this host and not blocked where your users are.
VPN_REALITY_DEST=www.microsoft.com:443
VPN_REALITY_SERVER_NAME=www.microsoft.com

# From `npm run keygen` (or the compose one-liner). Every node that should hand
# out the *same* link to an address shares VPN_CLIENT_SECRET; the Reality key is
# per node. Never commit these.
VPN_REALITY_PRIVATE_KEY=
VPN_REALITY_SHORT_ID=
VPN_CLIENT_SECRET=
