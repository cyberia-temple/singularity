map $http_upgrade $connection_upgrade {

  default upgrade;
  ''      close;
}

server {
    listen       80;
    server_name  cyberia.church www.cyberia.church;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://cyberia.church$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name www.cyberia.church;

    ssl_certificate /etc/letsencrypt/live/cyberia.church/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cyberia.church/privkey.pem;

    return 301 https://cyberia.church$request_uri;
}

server {
    listen 443 ssl http2;
    server_name cyberia.church;
    resolver 127.0.0.11 valid=30s ipv6=off;

    ssl_certificate /etc/letsencrypt/live/cyberia.church/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cyberia.church/privkey.pem;

    # CRM uploads include chat batches (5 x 25 MB) and task batches (8 x 5 MB).
    # nginx defaults to 1m, which returns its own bare 413 before Laravel can
    # validate an individual file. Keep enough multipart headroom for the
    # largest supported batch. Scoped to this server: the explorer and the RPC
    # have no business taking 128 MB bodies.
    client_max_body_size 128m;

    # What this node itself pinned — NFT pictures and metadata (channel posts,
    # the Telegram bot's fishing loot) — straight from the local Kubo store, so
    # the NFT market does not wait on rate-limited public gateways. Not a
    # general IPFS proxy: `only-if-cached` makes Kubo answer 412 for anything
    # not already here instead of fetching it for a stranger. Whatever it
    # serves is inert on this origin: a sandboxed, script-free CSP and nosniff.
    location ~ "^/ipfs/([A-Za-z0-9]{46,100})$" {
        set                   $ipfs_upstream ipfs:8080;
        proxy_pass            http://$ipfs_upstream/ipfs/$1;
        proxy_http_version    1.1;
        proxy_set_header      Host ipfs;
        proxy_set_header      Cache-Control "only-if-cached";
        proxy_set_header      Cookie "";
        proxy_connect_timeout 5s;
        proxy_read_timeout    15s;
        proxy_intercept_errors on;
        error_page 412 = @ipfs_missing;

        proxy_hide_header     Set-Cookie;
        add_header            Content-Security-Policy "default-src 'none'; img-src 'self' data:; sandbox" always;
        add_header            X-Content-Type-Options nosniff always;
        add_header            Access-Control-Allow-Origin * always;
        # Kubo already marks a CID immutable: its bytes can never change.
    }

    location @ipfs_missing {
        return 404;
    }

    location / {
        set                   $cyberia_church_upstream cyberia_church:9001;
        proxy_pass            http://$cyberia_church_upstream;

        # `php artisan serve` is the single-threaded PHP built-in dev server.
        # It does NOT support HTTP/1.1 keep-alive — reusing a connection (or
        # sending Connection: upgrade) makes it drop the socket and nginx then
        # returns 502. Force HTTP/1.0 with a fresh, closed connection per
        # request, and give it room to answer instead of failing instantly.
        proxy_http_version    1.0;
        proxy_set_header      Connection "";

        proxy_set_header      Host $host;
        proxy_set_header      X-Real-IP $remote_addr;
        proxy_set_header      X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header      X-Forwarded-Proto https;

        proxy_connect_timeout 10s;
        proxy_read_timeout    120s;
        proxy_send_timeout    120s;

        # Inertia routes (/lending, /dao …) emit large response headers — the
        # X-Inertia payload marker plus several big Set-Cookie values. The
        # default 4k/8k header buffer overflows ("upstream sent too big
        # header") and nginx returns 502. Give the response headers more room.
        proxy_buffer_size        32k;
        proxy_buffers            8 32k;
        proxy_busy_buffers_size  64k;

        # Retry the next attempt if the dev server drops a connection mid-flight.
        proxy_next_upstream   error timeout http_502 http_503;
    }
}

