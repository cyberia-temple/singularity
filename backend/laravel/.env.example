APP_NAME=Cyberia
APP_VERSION=v0.13.0
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Cyberia Arena (public contract coordinates; never put a private key here)
ARENA_CONTRACT_ADDRESS=
ARENA_RPC_URL=https://rpc.cyberia.church
ARENA_EXPLORER_URL=https://explorer.cyberia.church
LAUNCHPAD_SITES_DOMAIN=cyberia.church

# IPFS (services/ipfs/docker-compose.yml). Token sites and NFT metadata are
# pinned to the local Kubo API; the gateway is only how a CID is turned into an
# https link for browsers that cannot resolve ipfs:// themselves. In prod the
# app runs in a container, so this must be reachable from inside it
# (host.docker.internal, or the node's name on a shared network).
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY=https://ipfs.io

# Sponsored fees for the wallet (CyberiaGasStation, Cyberia only). An address
# that owns something here but holds no CYBER cannot move any of it, so the
# station hands it enough CYBER to sign for itself. The contract caps how much
# leaves it; this server only decides who qualifies.
#
# GAS_SPONSOR_PRIVATE_KEY is a *dedicated* operator key — deliberately not the
# bridge relayer, whose transactions already race the Telegram minter and the
# DCA bot for nonces. It also pays the gas that delivers each drip, so it needs
# a balance of its own; `php artisan gas:station` watches both it and the tank.
WALLET_GAS_SPONSOR_ENABLED=true
WALLET_GAS_STATION_ADDRESS=
GAS_SPONSOR_PRIVATE_KEY=
# The gate: sponsor an address the chain says already owns something. Turning
# this off makes the station a plain faucet, open to scripts.
WALLET_GAS_REQUIRE_HOLDING=true
WALLET_GAS_ALLOW_ACCOUNTS=true
WALLET_GAS_DAILY_PER_IP=5
WALLET_GAS_DAILY_TOTAL=500

# Cross-chain swaps in the wallet (/wallet → cross-chain swap). Cyberia has no
# liquidity on other chains, so a router quotes and delivers the whole route;
# this host only composes the request. Nothing here is a key — the deposit is
# signed in the browser and goes to the router's contract, never to Cyberia.
#
# CROSSCHAIN_FEE_ADDRESS is where Cyberia's cut lands, in whatever the user was
# spending, on the source chain. No address means no fee is asked for and the
# screens say so; it is deliberately not the bridge relayer, whose nonces are
# already contended. The fee shown to a user is always the one the router put
# in the quote, never this number.
CROSSCHAIN_ENABLED=true
CROSSCHAIN_API=https://api.relay.link
CROSSCHAIN_REFERRER=cyberia.church
CROSSCHAIN_FEE_ADDRESS=
CROSSCHAIN_FEE_BPS=75

# "Talk to Lain" web chat — plain OpenRouter, free models only. The
# openrouter/free router routes randomly (tiny models answer badly); prefer
# pinning a strong free instruct model.
OPENROUTER_API_KEY=
LAIN_CHAT_MODEL=openai/gpt-oss-20b:free
LAIN_CHAT_FALLBACK_MODEL=openrouter/free
LAIN_CHAT_TIMEOUT_SECONDS=90
# Holder gate: the signed-in wallet must hold this share of the live $LAIN
# supply (1000 bps = 10%).
LAIN_TOKEN_ADDRESS=0x05cd1afd5b2df3cca6ceab80cbc21168ec981e8b
LAIN_MINIMUM_SHARE_BPS=1000

# LainOS as a participant in the console's room (/crm/chat). The daemon runs on
# the host and listens on loopback, so Laravel in a container reaches it through
# the docker host address; unset means the room falls back to the tool-less
# persona above and says under every answer which one replied.
LAINOS_HTTP_URL=
LAINOS_HTTP_TIMEOUT=60
LAINOS_CONSOLE_ROOM=cyberia-console
# Whether that fallback is allowed at all. Off means an unreachable daemon is
# reported as exactly that.
CRM_CHAT_LAINOS_FALLBACK=true

# Who may open the console at all (/crm and everything under it). Two names for
# the same short list: the account id and the EVM wallet attached to it, either
# is enough. The wallets have a default (config/crm.php); the ids do not and
# must be named here, because an id means nothing in a database it was not
# written for — which is why a fresh local copy 404s on /crm until it names its
# own operator. Comma-separated.
CRM_ADMIN_USER_IDS=
# Left commented: an empty value is a value, and would empty the default list.
# CRM_ADMIN_WALLETS=

# Cyberia inference API (/api/ai/v1) — OpenAI-compatible, opened by holding the
# gate token rather than by signing up. It supports the free-claude-code
# provider catalogue; only providers whose credentials are set are exposed.
GROQ_API_KEY=
# Optional upstreams. Never expose these keys to an API caller.
NVIDIA_NIM_API_KEY=
CLINE_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
QWENCLOUD_API_KEY=
QWENCLOUD_CODING_API_KEY=
TOGETHER_API_KEY=
DEEPINFRA_API_KEY=
SILICONFLOW_API_KEY=
NEBIUS_API_KEY=
CHUTES_API_KEY=
FEATHERLESS_API_KEY=
AGNES_API_KEY=
ZENMUX_API_KEY=
WANDB_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=
GEMINI_API_KEY=
# Vertex uses a renewable access token supplied by the host and a project id.
VERTEX_ACCESS_TOKEN=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
CODESTRAL_API_KEY=
OPENCODE_API_KEY=
AI_GATEWAY_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=
HUGGINGFACE_API_KEY=
COHERE_API_KEY=
GITHUB_MODELS_TOKEN=
WAFER_API_KEY=
KIMI_API_KEY=
KIMI_CODE_API_KEY=
KILO_API_KEY=
MINIMAX_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
FIREWORKS_API_KEY=
NOVITA_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
ZAI_API_KEY=
TOKENROUTER_API_KEY=
NARAROUTE_API_KEY=
POOLSIDE_API_KEY=
OLLAMA_API_KEY=
# Local providers are opt-in so a public API never probes localhost by
# accident. Set the matching base URL when the service is not on this host.
AI_ENABLE_LMSTUDIO=false
AI_ENABLE_LLAMACPP=false
AI_ENABLE_OLLAMA=false
# Override one provider's default upstream id with AI_MODEL_<PROVIDER>, e.g.
# AI_MODEL_OPENAI=gpt-5.4. Add further allowlisted public models as a JSON list.
AI_EXTRA_MODELS_JSON=[]
AI_DEFAULT_MODEL=lain-fast
# Holder gate. Defaults to $LAIN at 0.5% of supply — far below the 10% that
# opens the holders' room, because a room is for a handful of people and an
# API is not. Point it at any ERC-20 on Cyberia by changing the address.
AI_GATE_TOKEN_ADDRESS=0x05cd1afd5b2df3cca6ceab80cbc21168ec981e8b
AI_GATE_TOKEN_SYMBOL=LAIN
AI_GATE_MINIMUM_SHARE_BPS=50
# Per-key spend limits on a shared upstream account.
AI_LIMIT_RPM=20
AI_LIMIT_RPD=2000
AI_LIMIT_MAX_OUTPUT_TOKENS=4096

# x402 — the paid door to /api/ai/v1, for a caller who holds nothing. Off
# until a payee and a facilitator are named; `php artisan x402:check` says
# whether the pairing works before a caller has to find out. The default
# facilitator serves Base Sepolia only, so leaving it while quoting mainnet
# terms is caught by that command rather than by an uncollected payment.
X402_ENABLED=false
X402_PAY_TO=
X402_NETWORK=eip155:8453
X402_FACILITATOR_URL=https://x402.org/facilitator
# Only if the facilitator authenticates, e.g. `Bearer …`.
X402_FACILITATOR_AUTHORIZATION=
X402_AI_PRICE=0.01
# Native USDC on Base. `name`/`version` are the token's EIP-712 domain, which
# the client signs against — not its display name.
X402_ASSET_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
X402_ASSET_SYMBOL=USDC
X402_ASSET_DECIMALS=6
X402_ASSET_EIP712_NAME="USD Coin"
X402_ASSET_EIP712_VERSION=2

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Contract addresses for /pixels, /predictions and /market default to the
# production deploys baked into the pages (see crypto/hardhat/deployments/).
# Set these only to point a build at a different deploy, then rebuild.
VITE_PIXEL_CONTRACT=
VITE_PREDICTIONS_CONTRACT=
VITE_NFT_CONTRACT=
VITE_NFT_MARKET=

# WalletConnect (Reown) cloud project id from https://cloud.reown.com.
# When set, "WalletConnect" appears in every wallet picker, enabling mobile
# wallets (MetaMask Mobile, Trust, Rainbow, Ledger Live, OKX …) via QR code
# or deep link. Leave empty to offer injected browser wallets only. Rebuild
# the frontend after changing it — the value is baked in at build time.
VITE_WALLETCONNECT_PROJECT_ID=

PROXY_URL="http://127.0.0.1:2080"

# Comma-separated emails granted access to /admin/bridge-analytics
BRIDGE_ADMIN_EMAILS=

# When true, the / page renders the new wizard-style bridge UI. Use ?legacy=1
# to force the old UI per session.
BRIDGE_NEW_UX=true

# Bridge fee, denominated in USD. flat_usd is added on top of rate_bps * amount.
BRIDGE_FEE_FLAT_USD=0.10
BRIDGE_FEE_RATE_BPS=0
BRIDGE_NATIVE_TRANSFER_GAS_LIMIT=21000
BRIDGE_NATIVE_GAS_PRICE_FLOOR_GWEI=3
BRIDGE_NATIVE_GAS_MULTIPLIER_BPS=20000
# Flat YTN fee retained from evm_to_yenten payouts (covers the Yenten
# network fee so the recipient receives the displayed net amount exactly).
BRIDGE_YENTEN_PAYOUT_FEE_YTN=0.01

# Auto-drop a small amount of native CYBER to empty EVM destinations.
BRIDGE_GAS_DROP_ENABLED=true
BRIDGE_GAS_DROP_AMOUNT=0.01
BRIDGE_GAS_DROP_THRESHOLD_WEI=0

# Chain-level kill switches. Yenten/BTC/LTC/XMR are DISABLED by default: the
# chain disappears from the profile UI and its routes reject quotes/submits.
# Flip to true once per-user deposit crediting runs unattended.
BRIDGE_CHAIN_YENTEN_ENABLED=false
BRIDGE_CHAIN_BTC_ENABLED=false
BRIDGE_CHAIN_LTC_ENABLED=false
BRIDGE_CHAIN_XMR_ENABLED=false

# Yenten/BTC/LTC/XMR corridors are teased in the bridge UI as "Coming soon"
# (visible, greyed out, not selectable) regardless of the switches above. To
# actually open one: set its COMING_SOON=false AND enable its chain.
BRIDGE_ROUTE_YENTEN_TO_EVM_COMING_SOON=true
BRIDGE_ROUTE_EVM_TO_YENTEN_COMING_SOON=true
BRIDGE_ROUTE_BTC_TO_EVM_COMING_SOON=true
BRIDGE_ROUTE_EVM_TO_BTC_COMING_SOON=true
BRIDGE_ROUTE_LTC_TO_EVM_COMING_SOON=true
BRIDGE_ROUTE_EVM_TO_LTC_COMING_SOON=true
BRIDGE_ROUTE_XMR_TO_EVM_COMING_SOON=true
BRIDGE_ROUTE_EVM_TO_XMR_COMING_SOON=true

# Native Yenten light-wallet bridge. The DEPOSIT_ADDRESS/WIF are the central
# wallet: it receives swept deposits and pays out evm_to_yenten. The WIF signs
# locally and is never sent to api.yentencoin.info.
BRIDGE_YENTEN_DEPOSIT_ADDRESS=
BRIDGE_YENTEN_RELAYER_WIF=
BRIDGE_YENTEN_API_URL=https://api.yentencoin.info
# Claim/deposit detection checks these in order. explorer2 is first because it
# is the fresher Blockbook indexer; api.yentencoin.info remains a fallback.
BRIDGE_YENTEN_BALANCE_API_URLS=https://explorer2.yentencoin.info,https://api.yentencoin.info
BRIDGE_YENTEN_MIN_CONFIRMATIONS=1
# One-time deposit addresses stop being monitored after this many minutes.
BRIDGE_YENTEN_DEPOSIT_TTL_MINUTES=60
# Master seed (32-byte hex) for per-request one-time deposit addresses. Each
# yenten_to_evm request derives its own address so a public deposit tx cannot
# be hijacked. Generate: php -r 'echo bin2hex(random_bytes(32));'
BRIDGE_YENTEN_HD_SEED=

# Manual Bitcoin/Litecoin/Monero bridge corridors (hidden entirely while the
# BRIDGE_CHAIN_*_ENABLED switches above stay false).
# They stay unavailable for submit until a deposit/payout address is configured.
# Requests stay pending for operator review unless dedicated relayers are added.
# The per-chain HD seeds power personal (CEX-style) profile deposit addresses:
# BTC/LTC derive a P2PKH address per user (WIF re-derivable for sweeping via
# `php artisan bridge:user-deposit`); XMR derives an 8-byte payment id and
# issues an integrated address, so funds land directly in the main wallet
# (BRIDGE_XMR_DEPOSIT_ADDRESS must be a standard 4... address). Yenten's
# personal addresses reuse BRIDGE_YENTEN_HD_SEED under a separate namespace.
# Generate a seed: php -r 'echo bin2hex(random_bytes(32));'
BRIDGE_BTC_DEPOSIT_ADDRESS=
BRIDGE_BTC_HD_SEED=
BRIDGE_BTC_MIN_CONFIRMATIONS=3
BRIDGE_ROUTE_BTC_TO_EVM_ENABLED=true
BRIDGE_ROUTE_EVM_TO_BTC_ENABLED=true
BRIDGE_LTC_DEPOSIT_ADDRESS=
BRIDGE_LTC_HD_SEED=
BRIDGE_LTC_MIN_CONFIRMATIONS=6
BRIDGE_ROUTE_LTC_TO_EVM_ENABLED=true
BRIDGE_ROUTE_EVM_TO_LTC_ENABLED=true
BRIDGE_XMR_DEPOSIT_ADDRESS=
BRIDGE_XMR_HD_SEED=
BRIDGE_XMR_MIN_CONFIRMATIONS=10
BRIDGE_ROUTE_XMR_TO_EVM_ENABLED=true
BRIDGE_ROUTE_EVM_TO_XMR_ENABLED=true

# CyberiaProfile contract: on-chain nicknames + achievements shown on /profile.
# Deployed 2026-07-10 at 0xa9101ee859850c037b0867156b3535F78A387C0d (owner =
# relayer EOA) — that address is the config default, so leave this var out
# unless overriding after a redeploy (deploy-profile.ts) or hiding the section
# (set it explicitly empty).
# CYBERIA_PROFILE_ADDRESS=

# --- Prediction market oracle (predictions:resolve, every 5 minutes) ---
# The PredictionMarket contract lets one address report outcomes, and gives it
# 30 days after a market closes before every stake becomes refundable and the
# outcome can never be reported at all. The scheduled command is what keeps
# that from happening; it signs with the relayer key (which owns the contract),
# so nothing extra is needed here for it to work. The deployed address is the
# config default — set this only after a redeploy.
# PREDICTIONS_CONTRACT_ADDRESS=
# Cancel a market nobody could answer shortly before its refund window closes:
# same money back, but visibly, instead of a market that quietly rots.
PREDICTIONS_AUTO_CANCEL=true
PREDICTIONS_CANCEL_GRACE_DAYS=3

# Where the oracle asks for help. Free-form markets can only be settled by a
# person, so the command reports them here once a day until they are answered.
# Optional: unset simply means those reports go to the log only.
TELEGRAM_OPS_BOT_TOKEN=
TELEGRAM_OPS_CHAT_ID=
# The service monitor shouts down the same channel. Alerts fire on state
# changes only, so an outage is announced once and its recovery once.

# --- CRM ingest (what LainOS did, on the operators' board) ---
# The daemon forges wishes, takes profit, fires watches and brings back digests
# on a machine this app cannot see, and none of that reached /crm/tasks. It now
# POSTs one record per thing to /api/crm/tasks behind this token — same rule as
# the heartbeat: unset means the route 404s, and this one writes. On the LainOS
# side it is LAINOS_CRM_TOKEN, with LAINOS_CRM_URL pointing here.
# Generate with: openssl rand -hex 32
CRM_INGEST_TOKEN=

# --- Service monitoring (/crm/services, `services:check`) ---
# The registry of what is supposed to be running lives in config/monitoring.php.
# Shared secret for the host heartbeat. Laravel runs in a container and cannot
# see the docker daemon, the tmux daemons, the load or the disk, so the host
# POSTs them to /api/ops/heartbeat once a minute from scripts/ops/heartbeat.sh.
# Unset means that endpoint 404s and every host-side check reads `unknown` —
# an open ingest would let anyone declare a dead host healthy.
# Generate with: openssl rand -hex 32
OPS_HEARTBEAT_TOKEN=
# More than one machine reports. Registry entries that do not name a host mean
# this one; unset falls back to whichever reported most recently.
OPS_HEARTBEAT_DEFAULT_HOST=
# LainOS runs on the operator's machine and was never deployed to the server,
# so it is checked against that machine's heartbeat and reads `unknown` — never
# `down` — until that machine reports. Set to its `hostname`.
MONITORING_LAINOS_HOST=
# MONITORING_ENABLED=false turns the sweep off entirely.
# MONITORING_ALERTS=false keeps the board and stops the Telegram messages.

# --- Slot machine ("одноручный бандит") ---
# Dedicated Solana hot wallet, completely separate from the bridge.
# Generate with: solana-keygen new -o ./storage/keys/slot-hot.json
SLOT_HOT_WALLET_ADDRESS=
SLOT_HOT_WALLET_KEYPAIR_PATH=
# Cluster: devnet | mainnet. Drives the default RPC for both server and
# browser sides. Use devnet while iterating — mainnet only when fully tested.
SLOT_CLUSTER=devnet
# Optional override. If empty, derived from SLOT_CLUSTER.
SLOT_RPC_URL=
SLOT_BURN_BPS=200
SLOT_HOUSE_EDGE_BPS=400
SLOT_JACKPOT_THRESHOLD_BPS=10
SLOT_MAX_SINGLE_WIN_BPS=2000
SLOT_MAX_BET_USD=50
# Refresh TTL for token metadata cache, hours.
SLOT_METADATA_TTL_HOURS=24
# Prepared spins expire after this many minutes if not confirmed.
SLOT_PREPARE_TTL_MINUTES=5

# --- Pump.fun auto-whitelist (Phase 2) ---
# Discovery uses pump.fun's public frontend API (no key required).
SLOT_PUMPFUN_API_BASE=https://frontend-api-v3.pump.fun
# Bulk import: hourly artisan command pulls top N by market cap >= min mcap.
SLOT_PUMPFUN_BULK_TOP_N=200
SLOT_PUMPFUN_MIN_MCAP_USD=10000
# Lazy auto-whitelist: when a user bets a mint not yet in the pool, verify it
# via pump.fun and add on the fly. Set false to require admin approval.
SLOT_PUMPFUN_LAZY_ENABLED=true
# When true, bulk + lazy imports set enabled=true (skip admin review) for
# tokens passing freeze-authority check.
SLOT_PUMPFUN_AUTO_ENABLE=true
# Web Push (browser notifications). Generate with: php artisan webpush:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@cyberia.church

# --- Native app shells (frontend/mobile, frontend/desktop) ---
# Deep links only open in the installed apps once these identities are
# published; /.well-known/assetlinks.json and
# /.well-known/apple-app-site-association stay 404 while they are empty.
# SHA-256 of the Android signing cert (upload key and Play key, comma separated):
# keytool -list -v -keystore <keystore> -alias <alias>
APP_ANDROID_PACKAGE=church.cyberia.app
APP_ANDROID_SHA256_FINGERPRINT=
# "<TEAM ID>.church.cyberia.app"
APP_IOS_APP_ID=

# --- /download ---
# The installers come from GitHub releases tagged app-v* (.github/workflows/apps.yml).
# Everything here has a working default; a token only raises the API rate limit,
# and needs no scopes for a public repository.
APP_DOWNLOADS_REPO=cyberia-temple/singularity
APP_DOWNLOADS_GITHUB_TOKEN=

# --- Auth: X (Twitter) OAuth 2.0 ---
# App from developer.x.com; callback must be {APP_URL}/auth/twitter/callback.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=/auth/twitter/callback

# --- Profile connections: GitHub OAuth + Telegram OIDC ---
# GitHub OAuth App callback:
# {APP_URL}/settings/connections/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI="${APP_URL}/settings/connections/github/callback"
# BotFather > Bot Settings > Web Login. Register this exact callback:
# {APP_URL}/settings/connections/telegram/callback
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=
TELEGRAM_LOGIN_REDIRECT_URI="${APP_URL}/settings/connections/telegram/callback"

# --- Bridge: TON ---
# Operator TON wallet receiving native TON + jetton deposits (friendly EQ../UQ..
# or raw form). TON routes are hidden from the UI while unset. Use the wallet
# controlled by TON_RELAYER_MNEMONIC so one hot wallet serves both directions.
BRIDGE_TON_DEPOSIT_ADDRESS=
# 24-word mnemonic of the TON relayer wallet (v4R2) for automatic payouts.
TON_RELAYER_MNEMONIC=
# Optional tonapi.io bearer key (higher rate limits for deposit verification).
TONAPI_KEY=
BRIDGE_TON_API_URL=https://tonapi.io
BRIDGE_TONCENTER_RPC_URL=https://toncenter.com/api/v2/jsonRPC
TONCENTER_API_KEY=
# Flat TON retained from evm_to_ton native payouts (covers the TON message fee).
BRIDGE_TON_PAYOUT_FEE_TON=0.01

# --- Bridge: Cyberia (home chain) ---
# Backend/relayer RPC. In prod this may point at the internal node
# (e.g. http://polygon-edge:8545) for speed/reliability.
BRIDGE_EVM_RPC_URL=
CYBERIA_RPC_URL=https://rpc.cyberia.church
# Browser-facing RPC for client-side token-balance reads. MUST be publicly
# reachable, CORS-open and HTTPS — never the internal node URL, or source
# balances render blank in the bridge UI when sending from Cyberia.
BRIDGE_EVM_PUBLIC_RPC_URL=https://rpc.cyberia.church

# --- Bridge: BNB Chain ---
# Use a private RPC endpoint in production (public dataseed rate-limits).
BRIDGE_BSC_RPC_URL=https://bsc-dataseed.binance.org
# Cyberia wrapper for native BNB (deployed via scripts/deploy-bnb.ts). USDT on
# BNB uses the unified USDT wrapper — no separate contract. Routes stay hidden
# while unset.
BRIDGE_BNB_WRAPPER_ADDRESS=
# Open the BNB <-> Cyberia corridor once the wrapper above is set and the
# relayer holds BNB gas + USDT reserves on BSC for evm_to_bnb payouts.
BRIDGE_ROUTE_BNB_TO_EVM_ENABLED=false
BRIDGE_ROUTE_EVM_TO_BNB_ENABLED=false

# --- Bridge: Base ---
# Use a private RPC endpoint in production (the public one rate-limits).
BRIDGE_BASE_RPC_URL=https://mainnet.base.org
# ETH and USDC on Base use the unified ETH / USDC wrappers (pooled reserves,
# no per-chain contract). Open the corridor once the relayer holds ETH gas +
# USDC reserves on Base for evm_to_base payouts.
BRIDGE_ROUTE_BASE_TO_EVM_ENABLED=false
BRIDGE_ROUTE_EVM_TO_BASE_ENABLED=false

# --- Bridge: Robinhood Chain ---
# Arbitrum-stack L2 (chain id 4663), gas token ETH. Alchemy endpoints are the
# recommended private RPC if the public one rate-limits.
BRIDGE_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Native ETH maps to the unified Cyberia ETH wrapper (pooled reserves, no
# per-chain contract). Inbound (robinhood_to_evm) is on by default — deposits
# land on the relayer EOA and pay out as a Cyberia mint, no Robinhood-side
# funds needed. Outbound shows as "Coming soon" until the relayer holds ETH on
# Robinhood Chain: then set ENABLED=true and COMING_SOON=false.
BRIDGE_ROUTE_ROBINHOOD_TO_EVM_ENABLED=true
BRIDGE_ROUTE_EVM_TO_ROBINHOOD_ENABLED=false
BRIDGE_ROUTE_EVM_TO_ROBINHOOD_COMING_SOON=true
# Bridged native CYBER ("Cyber" ERC20, relayer-owned mint/burn, no premint) on
# Robinhood Chain; the live deployment is baked into config/bridge.php,
# override only for a redeploy.
# BRIDGE_CYBER_ROBINHOOD_ADDRESS=0x753979e6585CCa139fbB1918966D563a25eEB3B2

# --- Bridge: Solana ---
# Defaults to the Helius RPC baked into config/bridge.php; override here.
BRIDGE_SOLANA_RPC_URL=
BRIDGE_SOLANA_HOT_WALLET=E6E8AeKoT6i2zmwrGyDF2LwfEfjX9Xg8LfEj2Fu8Yf7w

# --- Solana RPC relay (config/solana.php, POST /api/solana/rpc) ---
# Solana's public cluster answers this server and refuses the browser: any
# request carrying an Origin header comes back 403. So browser-side Solana
# reads (the wallet, the bridge, staking) go through this app, which also
# keeps the api key below out of the bundle.
# Upstreams are tried in order — keyed first, public cluster last — so an
# exhausted, rate-limited or dead key costs a moment rather than availability.
# FALLBACK and DEVNET accept a comma-separated list: stacking two or three free
# tiers (Helius, QuickNode, Chainstack, Syndica, GetBlock — see
# https://solana.com/rpc) is what keeps one provider's daily cap from being
# ours. The keyless endpoints on that page are mostly gone: Ankr's now wants a
# key, dRPC dropped Solana from its free plan, and publicnode drops the
# connection on getTokenAccountsByOwner. The official cluster is the floor and
# is appended automatically.
SOLANA_RPC_URL=
SOLANA_RPC_FALLBACK_URL=
SOLANA_DEVNET_RPC_URL=
SOLANA_RPC_PROXY_ENABLED=true
SOLANA_RPC_PROXY_TIMEOUT=20
SOLANA_RPC_PROXY_MAX_BATCH=25
SOLANA_RPC_PROXY_MAX_BYTES=131072
# Comma-separated browser origins allowed to use the relay (*.example.com is
# accepted). Empty means any — worth setting once a metered key is first in
# the list. A request with no Origin (curl, another server) always passes.
SOLANA_RPC_ALLOWED_ORIGINS=

# --- Custodial CYBER.sol staking ---
# Keep this treasury separate from BRIDGE_SOLANA_HOT_WALLET. The keypair is
# only used by the backend to return principal on withdrawal.
STAKING_SOLANA_ENABLED=false
STAKING_SOLANA_CLUSTER=mainnet
STAKING_SOLANA_RPC_URL=
STAKING_SOLANA_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
STAKING_SOLANA_TREASURY_ADDRESS=
STAKING_SOLANA_KEYPAIR_PATH=
# Economic policy: whole ASH earned by one whole CYBER.sol per day.
STAKING_ASH_PER_CYBER_PER_DAY=0
# Dedicated funded EVM payout wallet; never expose this value to the browser.
STAKING_EVM_RPC_URL=https://rpc.cyberia.church
STAKING_EVM_PRIVATE_KEY=
